# Copy to .env (gitignored) and fill in. docker compose reads it automatically.
# SQL Server requires strong passwords: 8+ characters with upper, lower and digits.
# One way to make one:  python3 -c "import secrets; print(secrets.token_urlsafe(18) + 'aA1')"

# administrator; used only by sqlserver and the one-off db-init container
SA_PASSWORD=
# each service's own login (db-init creates them)
PROMPTS_DB_PASSWORD=
EVALS_DB_PASSWORD=

# fake needs no key; anthropic calls the real API
LLM_PROVIDER=fake
LLM_API_KEY=
